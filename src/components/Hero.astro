---
// Hero section - Minimal editorial design
---

<section class="hero">
  <div class="hero-content">
    <div class="greeting">遊戲 × AI × 攻略</div>
    <h1 class="hero-title">
      <span class="title-text">遊戲實驗室</span>
    </h1>
    <p class="hero-description">
      <span>拆解遊戲小知識</span>
      <span>善用工具打造省力的日常</span>
    </p>
    <div class="hero-actions">
      <a
        href="https://www.youtube.com/@VincentGame"
        target="_blank"
        rel="noopener noreferrer"
        class="action-pill"
      >
        <span class="action-tag">影音頻道</span>
        <span class="action-divider" aria-hidden="true"></span>
        <span class="action-label">前往 YouTube 頻道</span>
        <svg class="action-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a
        href="https://vincentcodex.github.io/Marketing-Tools/"
        target="_blank"
        rel="noopener noreferrer"
        class="action-pill"
      >
        <span class="action-tag">自製工具</span>
        <span class="action-divider" aria-hidden="true"></span>
        <span class="action-label">整合行銷工具盒</span>
        <svg class="action-arrow action-arrow--ext" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- Decorative elements -->
  <div class="hero-decoration">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: calc(var(--nav-height) + 2rem) 2rem 3rem;
  }

  .hero-content {
    text-align: center;
    z-index: 10;
    max-width: 760px;
    animation: fadeInUp 0.8s ease-out;
  }

  .greeting {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    color: #E2E8F0;
    background: rgba(15, 23, 42, 0.58);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.42rem 1.15rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.8rem, 11vw, 6.2rem);
    font-weight: 700;
    margin-bottom: 1.35rem;
    letter-spacing: 0.02em;
    line-height: 1.08;
  }

  .title-text {
    background: linear-gradient(180deg, #FFFFFF 0%, #E2E8F0 65%, #94A3B8 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 1.25rem;
    row-gap: 0.35rem;
    font-size: clamp(1.02rem, 2.2vw, 1.22rem);
    color: #CBD5E1;
    margin-bottom: 2.75rem;
    line-height: 1.75;
    letter-spacing: 0.04em;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .action-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 52px;
    padding: 0.75rem 1.45rem;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-body);
    color: #F8FAFC;
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      color 0.25s ease;
  }

  .action-tag {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #FB923C;
    transition: color 0.25s ease;
  }

  .action-divider {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.16);
    transition: background-color 0.25s ease;
  }

  .action-label {
    letter-spacing: 0.02em;
  }

  .action-arrow {
    color: #FB923C;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .action-pill:hover,
  .action-pill:focus-visible {
    transform: translateY(-3px);
    background: rgba(234, 88, 12, 0.18);
    border-color: rgba(249, 115, 22, 0.6);
    color: #FFF7ED;
    box-shadow: 0 12px 28px rgba(2, 6, 23, 0.4),
      0 0 22px rgba(234, 88, 12, 0.24);
    outline: none;
  }

  .action-pill:hover .action-tag,
  .action-pill:focus-visible .action-tag {
    color: #FED7AA;
  }

  .action-pill:hover .action-divider,
  .action-pill:focus-visible .action-divider {
    background: rgba(253, 186, 116, 0.35);
  }

  .action-pill:hover .action-arrow,
  .action-pill:focus-visible .action-arrow {
    color: #FFF7ED;
    transform: translateX(3px);
  }

  .action-pill:hover .action-arrow--ext,
  .action-pill:focus-visible .action-arrow--ext {
    transform: translate(2px, -2px);
  }

  /* Decorative glows - 柔和低調環境光 */
  .hero-decoration {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: 0.2;
  }

  .glow-1 {
    width: 420px;
    height: 420px;
    background: #3B82F6;
    top: 8%;
    left: 12%;
    animation: float 14s ease-in-out infinite;
  }

  .glow-2 {
    width: 340px;
    height: 340px;
    background: #EA580C;
    bottom: 18%;
    right: 12%;
    opacity: 0.14;
    animation: float 12s ease-in-out infinite reverse;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%, 100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(20px, -20px);
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .title-text {
      animation: none;
    }
    .glow-1, .glow-2 {
      animation: none;
    }
    .hero-content {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 82vh;
      padding: calc(var(--nav-height) + 2.5rem) 1.25rem 3rem;
    }

    .hero-description {
      flex-direction: column;
      align-items: center;
      row-gap: 0.25rem;
      margin-bottom: 2.25rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: 0.85rem;
    }

    .action-pill {
      width: 100%;
      max-width: 310px;
      padding: 0.8rem 1.25rem;
    }
  }
</style>
