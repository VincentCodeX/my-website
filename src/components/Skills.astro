---
// Skills/Tech Stack section
---

<section class="skills">
  <div class="container">
    <header class="section-header">
      <span class="section-eyebrow">SKILLS &amp; STACK</span>
      <h2 class="section-title">技能與知識</h2>
      <p class="section-subtitle">我所使用的工具與持續探索的領域</p>
    </header>

    <div class="skills-grid">
      <div class="skill-category">
        <div class="category-header">
          <div class="category-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h3 class="category-title">影音與遊戲創作</h3>
        </div>
        <div class="skill-list">
          <span class="skill-tag">Astro</span>
          <span class="skill-tag">DaVinci Resolve</span>
          <span class="skill-tag">OBS Studio</span>
          <span class="skill-tag">FFmpeg</span>
          <span class="skill-tag">Auto-editor</span>
        </div>
      </div>

      <div class="skill-category">
        <div class="category-header">
          <div class="category-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
          </div>
          <h3 class="category-title">AI 與自動化應用</h3>
        </div>
        <div class="skill-list">
          <span class="skill-tag">Google Gemini</span>
          <span class="skill-tag">OpenAI Whisper</span>
          <span class="skill-tag">Google Apps Script</span>
          <span class="skill-tag">API 串接與應用</span>
        </div>
      </div>

      <div class="skill-category">
        <div class="category-header">
          <div class="category-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
              ></path>
            </svg>
          </div>
          <h3 class="category-title">網頁建置與管理</h3>
        </div>
        <div class="skill-list">
          <span class="skill-tag">Wix</span>
          <span class="skill-tag">GitHub Pages</span>
          <span class="skill-tag">Cloudflare</span>
          <span class="skill-tag">VS Code</span>
          <span class="skill-tag">Mac Terminal</span>
        </div>
      </div>

      <div class="skill-category">
        <div class="category-header">
          <div class="category-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
          </div>
          <h3 class="category-title">持續探索中</h3>
        </div>
        <div class="skill-list">
          <span class="skill-tag">新世代 AI 模型實測</span>
          <span class="skill-tag">進階自動化流程串接</span>
          <span class="skill-tag">Google Analytics</span>
          <span class="skill-tag">n8n / Make.com</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    padding: 5rem 2rem 8rem;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #CBD5E1;
    margin-bottom: 0.75rem;
    padding: 0.35rem 0.9rem;
    background: rgba(15, 23, 42, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #EA580C;
    box-shadow: 0 0 8px rgba(249, 115, 22, 0.8);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-dim);
    font-size: 1.05rem;
    margin-bottom: 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .skill-category {
    display: flex;
    flex-direction: column;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.125rem;
    padding: 1.75rem;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      background-color 0.28s ease;
  }

  .skill-category:hover {
    transform: translateY(-4px);
    background: rgba(15, 23, 42, 0.78);
    border-color: rgba(249, 115, 22, 0.45);
    box-shadow: 0 14px 36px rgba(2, 6, 23, 0.45),
      0 0 24px rgba(234, 88, 12, 0.14);
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .category-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(234, 88, 12, 0.14);
    border: 1px solid rgba(249, 115, 22, 0.28);
    border-radius: 0.7rem;
    color: #FB923C;
  }

  .category-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: #F8FAFC;
  }

  .category-badge {
    margin-left: auto;
    padding: 0.22rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #FED7AA;
    background: rgba(234, 88, 12, 0.14);
    border: 1px solid rgba(249, 115, 22, 0.35);
    border-radius: 9999px;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .skill-tag {
    padding: 0.4rem 0.85rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9999px;
    font-size: 0.82rem;
    color: #CBD5E1;
    transition: all 0.2s ease;
  }

  .skill-tag:hover {
    border-color: rgba(249, 115, 22, 0.45);
    background: rgba(234, 88, 12, 0.14);
    color: #FFF7ED;
  }

  @media (max-width: 768px) {
    .skills {
      padding: 4rem 1.5rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
