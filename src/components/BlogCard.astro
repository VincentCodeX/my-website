---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[] | undefined;
  heroImage?: string | undefined;
  variant?: 'default' | 'minimal-orange';
}

const base = import.meta.env.BASE_URL;
const { title, description, pubDate, slug, tags, heroImage, variant = 'default' } = Astro.props;

const isMinimalOrange = variant === 'minimal-orange';

const formattedDate = isMinimalOrange
  ? `${pubDate.getFullYear()}.${String(pubDate.getMonth() + 1).padStart(2, '0')}.${String(pubDate.getDate()).padStart(2, '0')}`
  : pubDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });

const primaryTag = tags && tags.length > 0 ? tags[0] : undefined;
const secondaryTags = tags && tags.length > 1 ? tags.slice(1, 3) : [];
---

{isMinimalOrange ? (
  <article class="blog-card blog-card--minimal">
    <a href={`${base}blog/${slug}/`} class="minimal-card-link">
      {heroImage && (
        <div class="minimal-card-media">
          <img src={heroImage} alt={title} loading="lazy" />
          <div class="minimal-media-overlay"></div>
          {primaryTag && <span class="minimal-badge">{primaryTag}</span>}
        </div>
      )}
      <div class="minimal-card-body">
        <div class="minimal-meta">
          <time class="minimal-date" datetime={pubDate.toISOString()}>
            <span class="minimal-date-dot" aria-hidden="true"></span>
            {formattedDate}
          </time>
          {!heroImage && primaryTag && <span class="minimal-inline-badge">{primaryTag}</span>}
        </div>
        <h3 class="minimal-title">{title}</h3>
        <p class="minimal-description">{description}</p>
        <div class="minimal-footer">
          <div class="minimal-tags">
            {secondaryTags.map((tag) => (
              <span class="minimal-tag">#{tag}</span>
            ))}
          </div>
          <span class="minimal-read-more">
            閱讀文章
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </div>
      </div>
    </a>
  </article>
) : (
<article class="blog-card">
  <a href={`${base}blog/${slug}/`} class="blog-card-link">
  {heroImage && (
    <div class="blog-card-image">
      <img src={heroImage} alt={title} loading="lazy" />
    </div>
  )}
    <div class="blog-card-content">
      <time class="blog-date">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        {formattedDate}
      </time>
      <h3 class="blog-title">{title}</h3>
      <p class="blog-description">{description}</p>
      {tags && tags.length > 0 && (
        <div class="blog-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      <span class="read-more">
        閱讀文章
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </span>
    </div>
  </a>
</article>
)}

<style>
  .blog-card {
    position: relative;
    height: 100%;
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 0;
    text-decoration: none;
    color: var(--color-text);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .blog-card-link:hover {
    border-color: var(--color-primary);
    box-shadow: 0 8px 30px rgba(59, 130, 246, 0.15);
  }

  .blog-card-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
  }

  .blog-date {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-text-dim);
    margin-bottom: 0.75rem;
  }

  .blog-date svg {
    opacity: 0.7;
  }

  .blog-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .blog-card-link:hover .blog-title {
    color: var(--color-primary);
  }

  .blog-description {
    color: var(--color-text-dim);
    line-height: 1.6;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    padding: 0.25rem 0.625rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary);
    margin-top: auto;
  }

  .read-more svg {
    transition: transform 0.2s ease;
  }

  .blog-card-link:hover .read-more svg {
    transform: translateX(4px);
  }

  .blog-card-image {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: 8px 8px 0 0;
}

.blog-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

  /* 方案 B：極簡高質感玻璃卡片 + 深橘色點綴 */
  .minimal-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.125rem;
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      background-color 0.28s ease;
  }

  .minimal-card-link:hover {
    transform: translateY(-4px);
    background: rgba(15, 23, 42, 0.78);
    border-color: rgba(249, 115, 22, 0.45);
    box-shadow: 0 14px 36px rgba(2, 6, 23, 0.45),
      0 0 24px rgba(234, 88, 12, 0.14);
  }

  .minimal-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: rgba(2, 6, 23, 0.6);
  }

  .minimal-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .minimal-card-link:hover .minimal-card-media img {
    transform: scale(1.045);
  }

  .minimal-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(2, 6, 23, 0.08) 0%,
      rgba(15, 23, 42, 0.55) 100%
    );
    pointer-events: none;
  }

  .minimal-badge {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    padding: 0.28rem 0.7rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #FED7AA;
    background: rgba(15, 23, 42, 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(249, 115, 22, 0.4);
    border-radius: 9999px;
  }

  .minimal-card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.35rem 1.45rem 1.25rem;
  }

  .minimal-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.7rem;
  }

  .minimal-date {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
  }

  .minimal-date-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #EA580C;
    box-shadow: 0 0 8px rgba(249, 115, 22, 0.7);
  }

  .minimal-inline-badge {
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #FDBA74;
    background: rgba(234, 88, 12, 0.14);
    border: 1px solid rgba(249, 115, 22, 0.3);
    border-radius: 9999px;
  }

  .minimal-title {
    font-family: var(--font-heading);
    font-size: 1.18rem;
    font-weight: 600;
    line-height: 1.45;
    margin-bottom: 0.6rem;
    color: #F8FAFC;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.22s ease;
  }

  .minimal-card-link:hover .minimal-title {
    color: #FB923C;
  }

  .minimal-description {
    font-size: 0.89rem;
    line-height: 1.65;
    color: #94A3B8;
    margin-bottom: 1.25rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .minimal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.95rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    margin-top: auto;
  }

  .minimal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-width: 0;
  }

  .minimal-tag {
    font-size: 0.75rem;
    color: #64748B;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 110px;
  }

  .minimal-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #F8FAFC;
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    white-space: nowrap;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      color 0.25s ease;
  }

  .minimal-read-more svg {
    color: #FB923C;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .minimal-card-link:hover .minimal-read-more {
    transform: translateY(-2px);
    color: #FFF7ED;
    background: rgba(234, 88, 12, 0.18);
    border-color: rgba(249, 115, 22, 0.6);
    box-shadow: 0 8px 20px rgba(2, 6, 23, 0.35),
      0 0 16px rgba(234, 88, 12, 0.22);
  }

  .minimal-card-link:hover .minimal-read-more svg {
    color: #FFF7ED;
    transform: translateX(3px);
  }
</style>
