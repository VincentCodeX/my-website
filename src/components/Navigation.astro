---
// Navigation component - Floating navbar with SVG icons
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
// BASE_URLを除いたパスで比較
const relativePath = currentPath.replace(base.slice(0, -1), '') || '/';
---

<nav class="nav">
  <div class="nav-container">
    <a href={base} class="logo">
      <img src={`${base}favicon.svg`} alt="" class="logo-icon" />
      <span>文森遊戲</span>
    </a>

    <div class="nav-links">
      <a href={base} class:list={['nav-link', { active: relativePath === '/' }]}>
        首頁
      </a>
      <a href={`${base}blog/`} class:list={['nav-link', { active: relativePath.toLowerCase().startsWith('/blog') }]}>
        部落格
      </a>
      <a href={`${base}projects/`} class:list={['nav-link', { active: relativePath.toLowerCase().startsWith('/projects') }]}>
        專案
      </a>
      <a href={`${base}about/`} class:list={['nav-link', { active: relativePath.toLowerCase().startsWith('/about') }]}>
        關於我
      </a>
      <a href="/youtube/" class:list={['nav-link', { active: relativePath.toLowerCase().startsWith('/youtube') }]}>
        頻道介紹
      </a>
    </div>

    <!-- Mobile menu button -->
    <button class="mobile-menu-btn" aria-label="Toggle menu" id="mobile-menu-btn">
      <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-content">
    <a href={base} class:list={['mobile-nav-link', { active: relativePath === '/' }]}>首頁</a>
    <a href={`${base}blog/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/blog') }]}>部落格</a>
    <a href={`${base}projects/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/projects') }]}>專案</a>
    <a href={`${base}about/`} class:list={['mobile-nav-link', { active: relativePath.startsWith('/about') }]}>關於我</a>
    <a href="/youtube/" class:list={['mobile-nav-link', { active: relativePath.startsWith('/youtube') }]}>頻道介紹</a>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: calc(100% - 2rem);
    max-width: 1200px;
    z-index: 1000;
    padding: 0.6rem 0.9rem 0.6rem 1.35rem;
    background: rgba(15, 23, 42, 0.72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    box-shadow: 0 10px 34px rgba(2, 6, 23, 0.42);
    animation: slideDown 0.5s ease-out;
  }

  .nav-container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.05em;
    color: #F8FAFC;
    transition: color 0.22s ease;
  }

  .logo-icon {
    width: 22px;
    height: 22px;
    display: block;
  }

  .logo:hover {
    color: #FB923C;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    padding: 0.48rem 1rem;
    color: #94A3B8;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    border-radius: 9999px;
    border: 1px solid transparent;
    transition: background-color 0.22s ease,
      border-color 0.22s ease,
      color 0.22s ease,
      box-shadow 0.22s ease;
    cursor: pointer;
  }

  .nav-link:hover {
    color: #FFF7ED;
    background: rgba(234, 88, 12, 0.14);
    border-color: rgba(249, 115, 22, 0.28);
  }

  .nav-link.active {
    color: #FED7AA;
    background: rgba(234, 88, 12, 0.2);
    border-color: rgba(249, 115, 22, 0.45);
    box-shadow: 0 0 14px rgba(234, 88, 12, 0.18);
  }

  .mobile-menu-btn {
    display: none;
    background: transparent;
    border: none;
    color: var(--color-text);
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-menu-btn .icon {
    width: 24px;
    height: 24px;
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.98);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 2rem;
  }

  .mobile-nav-link {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: #FB923C;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .nav {
      top: 0.75rem;
      width: calc(100% - 1.5rem);
      padding: 0.55rem 0.85rem 0.55rem 1.15rem;
    }

    .nav-links {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('open');
      });

      // Close menu when clicking a link
      const mobileLinks = mobileMenu.querySelectorAll('.mobile-nav-link');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
        });
      });
    }
  });
</script>
