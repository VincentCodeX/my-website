---
interface Props {
  title: string;
  description: string;
  image?: string | undefined;
  link?: string | undefined;
  github?: string | undefined;
  tags?: string[] | undefined;
  featured?: boolean | undefined;
  website?: string | undefined;
}

const base = import.meta.env.BASE_URL;
const { title, description, image, link, tags, featured, website } =
  Astro.props;
const imageSrc = image?.startsWith("/") ? `${base}${image.slice(1)}` : image;
---

<article class="project-card" class:list={{ featured }}>
  <div class="project-card-content">
    {featured && <span class="featured-badge">精選</span>}
    {
      image && (
        <div class="project-image">
          <img src={imageSrc} alt={title} loading="lazy" />
        </div>
      )
    }
    <h3 class="project-title">{title}</h3>
    <p class="project-description">{description}</p>
    {
      tags && tags.length > 0 && (
        <div class="project-tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )
    }
    <div class="project-links">
      {
        link && (
          <a
            href={link}
            class="project-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            Live Demo
          </a>
        )
      }
      {
        website && (
          <a
            href={website}
            class="project-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
            我早期由Wix架設的個人網站歡迎參觀！
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.125rem;
    padding: 1.5rem;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      background-color 0.28s ease;
  }

  .project-card.featured {
    border-color: rgba(249, 115, 22, 0.28);
  }

  .project-card:hover {
    transform: translateY(-4px);
    background: rgba(15, 23, 42, 0.78);
    border-color: rgba(249, 115, 22, 0.5);
    box-shadow: 0 14px 36px rgba(2, 6, 23, 0.45),
      0 0 24px rgba(234, 88, 12, 0.14);
  }

  .project-card-content {
    position: relative;
  }

  .featured-badge {
    display: inline-block;
    padding: 0.28rem 0.75rem;
    background: rgba(234, 88, 12, 0.18);
    border: 1px solid rgba(249, 115, 22, 0.45);
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #FED7AA;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .project-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: 1.25rem;
    border-radius: 0.75rem;
    overflow: hidden;
    background: rgba(2, 6, 23, 0.6);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .project-card:hover .project-title {
    color: #FB923C;
  }

  .project-description {
    color: var(--color-text-dim);
    line-height: 1.65;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .tag {
    padding: 0.25rem 0.65rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9999px;
    font-size: 0.75rem;
    color: var(--color-text-dim);
  }

  .project-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 0.95rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.95rem;
    color: #F8FAFC;
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      color 0.25s ease;
  }

  .project-link svg {
    color: #FB923C;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .project-link:hover,
  .project-link:focus-visible {
    transform: translateY(-2px);
    color: #FFF7ED;
    background: rgba(234, 88, 12, 0.18);
    border-color: rgba(249, 115, 22, 0.6);
    box-shadow: 0 10px 24px rgba(2, 6, 23, 0.35),
      0 0 18px rgba(234, 88, 12, 0.22);
    outline: none;
  }

  .project-link:hover svg,
  .project-link:focus-visible svg {
    color: #FFF7ED;
    transform: translate(2px, -2px);
  }
</style>
