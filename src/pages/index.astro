---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import BlogCard from '../components/BlogCard.astro';

const base = import.meta.env.BASE_URL;
const allBlogPosts = await getCollection('blog');
const recentPosts = allBlogPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="文森｜遊戲攻略 × AI應用 × 資訊分享" description="黃昇瑞 Vincent 的個人網站，分享遊戲攻略、AI 工具實測與創作心得" ogImage="/og-image.jpg">
  <Navigation />
  <Hero />

  <section class="recent-posts">
    <div class="container">
      <header class="section-header">
        <span class="section-eyebrow">LATEST POSTS</span>
        <h2 class="section-title">最新文章</h2>
        <p class="section-subtitle">近期發表的遊戲觀察、AI 實測與生活筆記</p>
      </header>
      <div class="posts-grid">
        {recentPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.id}
            tags={post.data.tags}
            heroImage={post.data.heroImage}
            variant="minimal-orange"
          />
        ))}
      </div>
      <div class="view-all">
        <a href={`${base}blog/`} class="btn btn-secondary">
          查看所有文章
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Skills />
</BaseLayout>

<style>
  .recent-posts {
    padding: 5rem 2rem 6rem;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #CBD5E1;
    margin-bottom: 0.75rem;
    padding: 0.35rem 0.9rem;
    background: rgba(15, 23, 42, 0.58);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #EA580C;
    box-shadow: 0 0 8px rgba(249, 115, 22, 0.8);
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: var(--color-text);
  }

  .section-subtitle {
    text-align: center;
    color: var(--color-text-dim);
    font-size: 1.05rem;
    margin-bottom: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  .view-all {
    text-align: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 50px;
    padding: 0.75rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-body);
    border-radius: 9999px;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      color 0.25s ease;
  }

  .btn-secondary {
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .btn-secondary svg {
    color: #FB923C;
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    transform: translateY(-3px);
    background: rgba(234, 88, 12, 0.18);
    border-color: rgba(249, 115, 22, 0.6);
    color: #FFF7ED;
    box-shadow: 0 12px 28px rgba(2, 6, 23, 0.4),
      0 0 22px rgba(234, 88, 12, 0.24);
    outline: none;
  }

  .btn-secondary:hover svg,
  .btn-secondary:focus-visible svg {
    color: #FFF7ED;
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .recent-posts {
      padding: 4rem 1.5rem 6rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
