---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThreeBackground from '../components/ThreeBackground.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string | undefined;
}

const base = import.meta.env.BASE_URL;
const {
  title = 'VincentGame',
  description = 'An intense motion-filled dark theme Astro site', ogImage 
} = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://vincent2077.com${Astro.url.pathname}`} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="文森｜遊戲攻略 × AI應用 × 資訊分享" />
    <link rel="canonical" href={`https://vincent2077.com${Astro.url.pathname}`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
  
    <!-- Google Fonts: Space Grotesk + DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
    <!-- ✅ GA4 START -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2ZBJD56F3M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2ZBJD56F3M', {
      page_path: window.location.pathname,
      });
    </script>
    <!-- ✅ GA4 END -->
  </head>
  <body>
    <ThreeBackground />
    <div id="page-content">
      <slot />
    </div>

    <style>
      #page-content {
        position: relative;
        z-index: 1;
      }
    </style>
    <div style="font-size: 0.75rem; opacity: 0.4; text-align: center; padding: 1rem;">
      <p style="margin: 0 0 0.3rem;"><a href="/privacy/" style="color: inherit; text-decoration: underline; text-underline-offset: 3px;">隱私權政策</a></p>
      <p style="margin: 0;">© 2026 VincentGame｜Template based on work by kpab (MIT License)</p>
    </div>
  </body>
</html>
